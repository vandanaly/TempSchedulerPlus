# Supabase Configuration
SUPABASE_URL=https://iucrcygsczrzjmvbpsvt.supabase.co
# CRITICAL: You MUST use the Service Role Key (starts with eyJ or sb_secret_) for backend uploads.
# Do NOT use the NEXT_PUBLIC publishable key here.
SUPABASE_SERVICE_ROLE_KEY=YOUR_REVEALED_SERVICE_ROLE_KEY_GOES_HERE
SUPABASE_BUCKET_NAME=cold-storage
SUPABASE_BUCKET_PREFIX=cold_data

# API Configuration (Fix for the localhost trap)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Configuration
FIREBASE_KEY_FILE=firebase_key.json
FIREBASE_STORAGE_BUCKET=your-firebase-bucket.appspot.com
FIREBASE_METADATA_COLLECTION=files

# TempSched+ Configuration
TEMPSCHED_USERNAME=admin
TEMPSCHED_PASSWORD=tempschedplus
TEMPSCHED_ENABLE_UPLOAD_ENCRYPTION=1
TEMPSCHED_DELETE_AFTER_UPLOAD=0

# Auto Parameter Tuning & Adaptive Scheduling
TEMPSCHED_AUTO_TUNE=1
TEMPSCHED_TEMP_AMBIENT=350.0
TEMPSCHED_TEMP_DECAY_RATE_PER_HOUR=0.25

# Scanning Configuration
TEMPSCHED_SCAN_PATHS=C:\Users\vandu\Downloads;C:\Users\vandu\Documents
TEMPSCHED_SCAN_MAX_FILES=1500
TEMPSCHED_SCAN_MIN_SIZE_BYTES=4096
TEMPSCHED_SCAN_MAX_DEPTH=4
TEMPSCHED_SCAN_MAX_STAGE_BYTES=524288000